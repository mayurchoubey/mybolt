# Phase 1 MVP Configuration
# Copy this to .env.local and adjust paths as needed

# Server-side code saving (enabled by default)
VITE_SERVER_CODE_SAVE_ENABLED=true

# Base path where project files will be mirrored on the server
# Use ~/ for home directory, ./ for relative to current working directory, or absolute path
SERVER_SAVE_BASE_PATH=~/bolt-projects/current

# Alternative: Use the legacy VITE variable name
# VITE_SERVER_CODE_SAVE_PATH=~/bolt-projects/current

# Disable Git writes to WebContainer (recommended for Phase 1)
VITE_DISABLE_GIT_WRITES=true
